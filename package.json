{
  "name": "dsh-plugin-storage-inspector",
  "version": "1.1.1",
  "description": "DeepSeek Harness 本地存储空间分析与跨项目依赖治理插件：按工作区/会话/文件类别剖析磁盘占用，可选清理白名单内的构建、依赖、归档会话与缓存目录；跨工作区只读扫描 package.json 与 npm 锁文件，输出版本漂移与 Node 分桶冲突矩阵。 | DSH storage analyzer with opt-in allow-listed cleanup, plus a read-only cross-project dependency drift matrix.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "storage",
    "storage-inspector",
    "dependency-governance",
    "drift-matrix",
    "node-version",
    "cordis"
  ],
  "author": "Siom126",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siom126/dsh-plugin-storage-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/Siom126/dsh-plugin-storage-inspector/issues"
  },
  "homepage": "https://github.com/Siom126/dsh-plugin-storage-inspector#readme",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.mjs"
  }
}
