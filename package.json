{
  "name": "dsh-plugin-storage-inspector",
  "version": "1.1.0",
  "description": "DeepSeek Harness 本地存储空间全景洞察与跨项目依赖治理插件：分析工作区磁盘体积、会话Session记录、物理文件类别剖析；只读扫描跨项目package/lockfile依赖，检测版本漂移、Node环境分桶与治理风险。 | DSH storage analyzer & read-only cross-project dependency governance plugin.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "storage",
    "storage-inspector",
    "dependency-governance",
    "drift-matrix",
    "node-version",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/**/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siom126/dsh-plugin-storage-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/Siom126/dsh-plugin-storage-inspector/issues"
  },
  "homepage": "https://github.com/Siom126/dsh-plugin-storage-inspector#readme",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
